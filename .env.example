# Copiar para .env.local (nunca vai para o git) e repetir na Vercel.
# Sem estas variáveis o site roda em modo demonstração e avisa na tela.
# Onde pegar cada uma: docs/ARQUITETURA-PAGAMENTOS.txt, seção 4.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# "sandbox" ou "producao"
ASAAS_AMBIENTE=sandbox
# Chave da conta Asaas DA ORGANIZAÇÃO, sem expiração
ASAAS_API_KEY=
# Carteira do MA24 (split). Em produção, vazio = cobrança recusada.
ASAAS_WALLET_ID_MA24=
REPASSE_PERCENTUAL=10
# Inventado por nós; o mesmo valor vai no cadastro do webhook no Asaas
ASAAS_WEBHOOK_TOKEN=
# Só para conta de TESTE em produção: "1" permite cobrar sem split
PERMITIR_SEM_SPLIT=
# Endereço público do site, sem barra no fim (ex.: https://redentor.vercel.app).
# Liga o retorno ao site depois do pagamento. Só preencher DEPOIS de cadastrar
# esse domínio no Asaas (Configurações da conta > Informações), senão a cobrança é recusada.
SITE_URL=
